{
  "manifest_version": 3,
  "name": "Stride StudyPilot — Autonomous AI LMS & Quiz Agent",
  "version": "2.0.0",
  "description": "Next-generation 5-Agent academic copilot for Amity Online (Amigo) and Moodle LMS platforms. Powered by Stride.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://amigo.amityonline.com/*",
    "*://*.amityonline.com/*",
    "*://*.moodle.com/*",
    "*://*.moodlecloud.com/*",
    "*://*.moodle.org/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.cerebras.ai/*",
    "https://stride.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "Stride StudyPilot — Autonomous Learning Agent",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://amigo.amityonline.com/*",
        "*://*.amityonline.com/*",
        "*://*.moodle.com/*",
        "*://*.moodlecloud.com/*",
        "*://*.moodle.org/*"
      ],
      "js": [
        "hud-ui.js",
        "agent/scribe.js",
        "agent/scholar.js",
        "agent/auditor.js",
        "agent/sentry.js",
        "agent/navigator.js",
        "agent/inspector.js",
        "content.js"
      ],
      "css": [
        "hud.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle_studypilot": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Launch or Toggle Stride StudyPilot HUD"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "hud.shadow.css",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
