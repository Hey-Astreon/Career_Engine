datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum ApplicationStatus {
  DISCOVERED
  SHORTLISTED
  APPLIED
  SCREENING
  TECHNICAL_ROUND
  OFFER
  REJECTED
  QUIET
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED_DIRECT_ATS
  VERIFIED_AGGREGATOR
  COMMUNITY_SUBMITTED
  FLAGGED_STALE
}

enum SyncStatus {
  HEALTHY
  DEGRADED
  FAILING
  DISABLED
}

enum RemoteScope {
  WORLDWIDE
  INDIA
  APAC
  EMEA
  AMERICAS
  US_ONLY
  EU_UK_ONLY
  COUNTRY_SPECIFIC
  UNKNOWN
}

enum PlatformSource {
  LINKEDIN
  WELLFOUND
  YC_JOBS
  NAUKRI
  GREENHOUSE
  LEVER
  ASHBY
  MICRO1
  ALIGNER
  DIRECT_PORTAL
  HIMALAYAS
  REMOTIVE
  HN_HIRING
  WORKABLE
  SMARTRECRUITERS
  RECRUITEE
  WEWORKREMOTELY
  JOBICY
  ARBEITNOW
  REMOTEOK
  HIRING_CAFE
  SIMPLIFY
  TRUEUP
  ARC_DEV
  BUILTIN
  THEHUB
}

model ProviderSyncState {
  id                   String     @id @default(uuid())
  providerKey          String     @unique
  status               SyncStatus @default(HEALTHY)
  lastSyncAttemptAt    DateTime?
  lastSuccessfulSyncAt DateTime?
  lastFailedSyncAt     DateTime?
  consecutiveFailures  Int        @default(0)
  lastError            String?
  totalJobsSeen        Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  occurrences JobOccurrence[]

  @@map("provider_sync_states")
}

model ProviderEndpointRun {
  id           String   @id @default(uuid())
  scrapeRunId  String
  providerKey  String
  endpointKey  String
  endpointUrl  String
  observedAt   DateTime @default(now())

  success      Boolean
  latencyMs    Int
  attemptCount Int
  statusCode   Int?
  retryAfterMs Int?
  errorMessage String?

  @@index([scrapeRunId])
  @@index([providerKey, observedAt])
  @@index([providerKey, endpointKey, observedAt])
  @@index([observedAt])
  @@map("provider_endpoint_runs")
}

model Profile {
  id               String              @id @default(uuid())
  slug             String              @unique
  fullName         String
  title            String
  email            String
  phone            String?
  location         String
  portfolioUrl     String?
  githubUrl        String?
  linkedinUrl      String?
  masterResumePath String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  projects       Project[]
  virtualExps    VirtualExperience[]
  applications   Application[]
  matchScores    MatchScore[]
  resumeVariants ResumeVariant[]

  userId         String? @unique
  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// NextAuth Models
model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  alertPreference UserAlertPreference?

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Project {
  id           String   @id @default(uuid())
  profileId    String
  title        String
  techStack    String
  liveDemoUrl  String?
  githubUrl    String?
  architecture String
  bulletPoints String
  createdAt    DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model VirtualExperience {
  id           String   @id @default(uuid())
  profileId    String
  company      String
  roleTitle    String
  period       String
  problemScope String
  actionTaken  String
  outcome      String
  createdAt    DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("virtual_experiences")
}

model JobPosting {
  id                 String            @id @default(uuid())
  urlHash            String            @unique
  url                String
  company            String
  title              String
  category           String            @default("Software Developer")
  jobType            String            @default("Remote Full-Time")
  experienceLevel    String            @default("0-3 Years (Entry/Junior)")
  platform           PlatformSource
  location           String
  isRemote           Boolean           @default(true)
  remoteScope        RemoteScope       @default(UNKNOWN)
  opportunitySignals String            @default("[]")
  applicantCount     Int?
  postedAt           DateTime?
  rawDescription     String
  lastSeenAt         DateTime          @default(now())
  isExpired          Boolean           @default(false)
  hasFullText        Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  matchScores  MatchScore[]
  applications Application[]

  @@index([postedAt])
  @@index([isRemote])
  @@index([category])
  @@index([lastSeenAt])
  @@index([isExpired])
  @@index([isExpired, postedAt(sort: Desc), createdAt(sort: Desc)], map: "job_postings_isExpired_postedAt_createdAt_idx")
  @@map("job_postings")
}

model Opportunity {
  id                 String            @id @default(uuid())
  company            String
  companySlug        String
  title              String
  category           String            @default("Software Developer")
  jobType            String            @default("Remote Full-Time")
  experienceLevel    String            @default("0-3 Years (Entry/Junior)")
  location           String
  isRemote           Boolean           @default(true)
  remoteRegion       String?
  remoteScope        RemoteScope       @default(UNKNOWN)
  opportunitySignals String            @default("[]")
  canonicalAppUrl    String
  technologies       String            @default("[]")
  rawDescription     String
  hasFullText        Boolean           @default(true)

  postedAt           DateTime?
  firstSeenAt        DateTime          @default(now())
  lastSeenAt         DateTime          @default(now())
  isExpired          Boolean           @default(false)
  expiredAt          DateTime?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  occurrences  JobOccurrence[]
  matchScores  MatchScore[]
  applications Application[]

  @@index([postedAt])
  @@index([isRemote])
  @@index([category])
  @@index([isExpired])
  @@index([companySlug, title])
  @@map("opportunities")
}

model JobOccurrence {
  id                 String             @id @default(uuid())
  opportunityId     String
  providerKey        String
  sourceJobId        String?
  discoveryUrl       String
  applicationUrl     String
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rawLocation        String?
  postedAt           DateTime?
  firstSeenAt        DateTime           @default(now())
  lastSeenAt         DateTime           @default(now())
  metadata           String?

  opportunity  Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  providerSync ProviderSyncState @relation(fields: [providerKey], references: [providerKey], onDelete: Cascade)

  @@unique([providerKey, sourceJobId])
  @@index([opportunityId])
  @@index([providerKey])
  @@map("job_occurrences")
}

model MatchScore {
  id            String   @id @default(uuid())
  profileId     String
  jobPostingId  String?
  opportunityId String?
  score         Int
  hardSkills    String
  missingSkills String
  reasoning     String
  evaluatedAt   DateTime @default(now())

  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobPosting  JobPosting?  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobPostingId])
  @@unique([profileId, opportunityId])
  @@map("match_scores")
}

model Application {
  id                     String            @id @default(uuid())
  profileId              String
  jobPostingId           String?
  opportunityId         String?
  status                 ApplicationStatus @default(DISCOVERED)
  tailoredCvPath         String?
  tailoredCoverLetter    String?
  atsExtractabilityScore Int?
  resumeVariantName      String?
  coldEmailDraft         String?
  recruiterDmDraft       String?
  dispatchedAt           DateTime?
  appliedAt              DateTime?
  lastContactAt          DateTime?
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobPosting  JobPosting?  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@map("applications")
}

model ResumeVariant {
  id           String   @id @default(uuid())
  profileId    String
  name         String
  category     String   @default("General")
  resumeData   String
  atsScore     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
  @@map("resume_variants")
}

model SchedulerRun {
  id              String    @id @default(uuid())
  triggeredBy     String    @default("CRON")
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  durationMs      Int?
  totalDiscovered Int       @default(0)
  totalInserted   Int       @default(0)
  totalUpdated    Int       @default(0)
  providersFailed Int       @default(0)
  providersTotal  Int       @default(0)
  alertsGenerated String    @default("[]")
  status          String    @default("RUNNING")
  error           String?

  @@index([startedAt])
  @@map("scheduler_runs")
}

model UserAlertPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  emailDigest         Boolean  @default(true)
  frequency           String   @default("DAILY")
  categories          String   @default("[]")
  matchScoreThreshold Int      @default(70)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_alert_preferences")
}
