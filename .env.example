# ==============================================================================
# AstreWork / CareerAgent — Environment Configuration Blueprint (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Persistence (Turso LibSQL Cloud or Local SQLite)
# ------------------------------------------------------------------------------
# For local dev: file:./prisma/dev.db
# For production: libsql://astrework-db-<tenant>.turso.io
TURSO_DATABASE_URL=file:./prisma/dev.db
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token-here

# ------------------------------------------------------------------------------
# 2. Redis In-Memory Cache Mesh (Redis 7)
# ------------------------------------------------------------------------------
# Default: redis://localhost:6379 (auto-falls back to bounded in-memory LRU if offline)
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. NextAuth Authentication & Session Management
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=your-random-32-byte-hex-secret
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_URL=https://astrework.app # in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://astrework.app # in production

# OAuth Providers (Optional for local dev, active in production)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-client-secret

# ------------------------------------------------------------------------------
# 4. Multi-LLM AI Routing Mesh (Groq, Gemini, Cerebras, NVIDIA NIM)
# ------------------------------------------------------------------------------
# Tier-1: Ultra-fast Groq inference (openai/gpt-oss-120b @ 500+ tokens/sec)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Tier-2: Google Gemini 3.8 Flash (gemini-3.8-flash, 1M context, GA)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Tier-3: Cerebras high-throughput inference (qwen-3.8-27b)
CEREBRAS_API_KEY=csk_your_cerebras_api_key_here

# Tier-4: NVIDIA NIM enterprise inference (meta/llama-4-maverick)
NVIDIA_NIM_API_KEY=nvapi-your_nvidia_nim_api_key_here

# ------------------------------------------------------------------------------
# 5. Autonomous Discovery Scheduler & Cron Security
# ------------------------------------------------------------------------------
# In-process auto-start (set to "true" on dedicated Docker / Oracle Cloud VMs)
AUTO_START_SCHEDULER=true

# Bearer secret for authenticating automated cron requests to /api/scheduler
CRON_SECRET=your-cron-secret-token-here

# ------------------------------------------------------------------------------
# 6. Email Alerts & Notification Digest (SMTP)
# ------------------------------------------------------------------------------
# SMTP connection URI: smtp://user:pass@smtp.mailgun.org:587
EMAIL_SERVER=
EMAIL_FROM=noreply@astrework.app

# ------------------------------------------------------------------------------
# 7. Search Console & Verification Tokens
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=DBE7LKgr6629Xr788PYMUHHMsP1273JDlxVNAEKoS0I

# ------------------------------------------------------------------------------
# 8. Antigravity Python Agent Gateway (Local or Cloud Heroku / Azure)
# ------------------------------------------------------------------------------
# Local: http://127.0.0.1:8000
# Cloud (Heroku/Azure): https://agent.astrework.app
AGENT_GATEWAY_URL=http://127.0.0.1:8000
AUTO_START_SCHEDULER=true


